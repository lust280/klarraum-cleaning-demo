# Copy to .env.local (ignored); run: node --env-file=.env.local server.mjs
# Never put real credentials in Git. Preview works without this file.
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
ENABLE_INQUIRIES=false
RETENTION_DAYS=90
TRUST_PROXY=0
# Generate locally using `npm run admin:hash`; enter resulting hash securely.
ADMIN_PASSWORD_HASH=
# Generate with `npm run secret:generate`; enter securely in hosting settings.
APP_SECRET=
BUSINESS_NAME=Klarraum
BUSINESS_OWNER=
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
BUSINESS_PHONE=
# Describe whether final prices include VAT or another applicable tax treatment.
PRICE_NOTE=
BUSINESS_LEGAL_DETAILS=
# Complete reviewed notice including hosting, mail, legal basis, rights, backups,
# processors/transfers and supervisory authority. Use hosting multiline values.
PRIVACY_DETAILS=
LEGAL_REVIEWED=false
# Comma-separated postal prefixes; use full five-digit codes for exact areas.
SERVICE_POSTCODES=90,91
# Resend requires an account and a verified sending domain for real recipients.
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO=
