# Copy to .env.local (ignored); run: node --env-file=.env.local server.mjs
# Never put real credentials in Git. Preview works without this file.
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
ENABLE_INQUIRIES=false
RETENTION_DAYS=90
TRUST_PROXY=0
# Generate locally using `npm run admin:hash`; enter resulting hash securely.
ADMIN_PASSWORD_HASH=
# Generate with `npm run secret:generate`; enter securely in hosting settings.
APP_SECRET=
BUSINESS_NAME=Klarraum
BUSINESS_OWNER=
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
BUSINESS_PHONE=
# Describe whether final prices include VAT or another applicable tax treatment.
PRICE_NOTE=
BUSINESS_LEGAL_DETAILS=
# Complete reviewed notice including hosting, mail, legal basis, rights, backups,
# processors/transfers and supervisory authority. Use hosting multiline values.
PRIVACY_DETAILS=
LEGAL_REVIEWED=false
# Comma-separated postal prefixes; use full five-digit codes for exact areas.
SERVICE_POSTCODES=90,91
# Resend requires an account and a verified sending domain for real recipients.
# A single-company install uses these three values. Platform companies instead
# use PLATFORM_RESEND_API_KEY and PLATFORM_MAIL_FROM on the director, plus the
# contact email saved by that company's owner.
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO=
# Customer confirmation and appointment reminders send when Resend is configured.
# Set false to keep those customer emails off. They never include the street address.
# MAIL_CUSTOMER_RECEIPT=false

# Stripe Checkout stays off even if these are filled in. Do not set them yet.
# Partner Connect (Billing → Customer payments) is a stub and never reads these keys.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# Google Calendar connects for a company owner when both keys are set.
# The same keys also enable Continue with Google on the public plan page.
# Set them on both the platform service and the klarraumapp.com service.
# Leave them empty to hide both. Calendar and sign-in use different callbacks.
# A request to klarraumapp.com or platform.klarraumapp.com uses that host's callback.
# See docs/GOOGLE-CALENDAR.md and docs/GOOGLE-SIGNIN-RU.md.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=
# GOOGLE_SIGNIN_REDIRECT_URI=

# Employee inbox always works. Optional operational emails require a verified Resend sender.
EMPLOYEE_EMAIL_NOTIFICATIONS=false
# Set true only after testing persistence across restart/deployment on your hosting.
PERSISTENT_STORAGE_CONFIRMED=false
