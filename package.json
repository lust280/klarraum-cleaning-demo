    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  }
}
