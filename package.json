{
  "name": "klarraum-cleaning-demo",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test pricing.test.mjs test/*.test.mjs",
    "deploy": "node scripts/publish.mjs",
    "admin:hash": "node scripts/hash-password.mjs",
    "secret:generate": "node --input-type=module -e \"import {randomBytes} from 'node:crypto';console.log(randomBytes(32).toString('base64url'))\"",
    "backup": "node scripts/backup.mjs",
    "test:browser": "playwright test",
    "setup": "node scripts/setup.mjs",
    "start:local": "node --env-file=.env.local server.mjs",
    "release": "node scripts/package.mjs",
    "restore": "node scripts/restore.mjs",
    "licenses": "node scripts/licenses.mjs",
    "doctor": "node --env-file-if-exists=.env.local scripts/doctor.mjs",
    "director": "node --env-file-if-exists=.env.director director.mjs",
    "platform:backup": "node scripts/platform-backup.mjs",
    "platform:restore": "node scripts/platform-restore.mjs"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  }
}
