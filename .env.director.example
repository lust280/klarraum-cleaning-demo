# Separate credentials and storage from every company installation.
DIRECTOR_ORIGIN=http://director.localhost:3100
COMPANY_BASE_DOMAIN=companies.localhost
DIRECTOR_DATA_DIR=./director-data
# Generate locally with npm run admin:hash. Never commit the result.
DIRECTOR_PASSWORD_HASH=
# Work emails allowed to request an operator sign-in link. Outside production,
# an unset list allows operator@klarraumapp.de and the response includes a demo link.
# DIRECTOR_OPERATOR_EMAILS=operator@klarraumapp.de
PORT=3100
# Shared sender for trial links and company inquiry notices. Leave blank until
# the Resend domain is verified. Do not commit real keys.
# PLATFORM_RESEND_API_KEY=
# PLATFORM_MAIL_FROM=KlarraumApp <inquiries@your-verified-domain>
# Operator address for AI escalation mail. Sent only when platform mail is configured.
# DIRECTOR_OPERATOR_EMAIL=
# Each company stores its own recipient (contact email) in the director registry.
# Customer confirmation and appointment reminders use the same sender when it is set.
# Set MAIL_CUSTOMER_RECEIPT=false on a company process to disable them.
# Stripe Checkout stays off. Do not set these yet.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# Google Calendar for company workspaces, and Google sign-in for a new owner.
# Set these on the director process. Calendar keys are copied into each company
# process. Leave them empty to hide both controls. See docs/GOOGLE-CALENDAR.md
# and docs/GOOGLE-SIGNIN.md. Sign-in uses a different callback than calendar.
# GOOGLE_CALENDAR_REDIRECT_URI defaults to DIRECTOR_ORIGIN/api/google/calendar/callback.
# GOOGLE_SIGNIN_REDIRECT_URI defaults to DIRECTOR_ORIGIN/api/google/signup/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=
# GOOGLE_SIGNIN_REDIRECT_URI=
