# Separate credentials and storage from every company installation.
DIRECTOR_ORIGIN=http://director.localhost:3100
COMPANY_BASE_DOMAIN=companies.localhost
DIRECTOR_DATA_DIR=./director-data
# Generate locally with npm run admin:hash. Never commit the result.
DIRECTOR_PASSWORD_HASH=
PORT=3100
# Shared sender for trial links and company inquiry notices. Leave blank until
# the Resend domain is verified. Do not commit real keys.
# PLATFORM_RESEND_API_KEY=
# PLATFORM_MAIL_FROM=KlarraumApp <inquiries@your-verified-domain>
# Each company stores its own recipient (contact email) in the director registry.
# Customer receipt mail stays off unless a company installation sets MAIL_CUSTOMER_RECEIPT=true.
